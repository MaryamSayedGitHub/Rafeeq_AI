# Rafeeq settings. Copy this file to .env and fill the keys.
#   Windows:  copy .env.example .env        macOS/Linux:  cp .env.example .env
# Every name appears ONCE in this file: when a name is written twice, the LAST line wins
# (that is how the knowledge base used to end up switched off).
# Check the hosted model with:  uv run python -m rafeeq.copilot.check_llm
# Check the whole app with:     uv run python scripts/smoke_check.py   (while the server runs)

# ============================================================================
# 1) REQUIRED: one hosted model for everything (free key at console.groq.com)
# ============================================================================
# Used by: the Copilot router (M1), the tutor and its answers (M3), quiz generation (M4),
# Snap photo reading (M1 + M3), topic names and lesson overviews (M2). The model must accept images.
LLM_API_KEY=put-your-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# M2 knowledge base: PDF indexing, hybrid search, citations, room topics.
# Needs:  uv sync --extra knowledge   (the first upload downloads BAAI/bge-m3, about 2.3 GB)
RAFEEQ_KNOWLEDGE=1
# 1 = the Copilot also uses M2's lesson overview and topic-of-citations hooks (they use LLM_* above).
# (M3 replaces M2's answerer for normal questions, so no Gemini key is needed for answers.)
RAFEEQ_KNOWLEDGE_TUTOR=1
# RAFEEQ_KNOWLEDGE_DIR=storage/knowledge/vector_store
# RAFEEQ_KNOWLEDGE_DEVICE=cpu            # or cuda
# RAFEEQ_KNOWLEDGE_RETRIEVAL=hybrid      # or dense
# RAFEEQ_KNOWLEDGE_EXCLUDE=1             # skip index-like pages
# RAFEEQ_KNOWLEDGE_RERANK=0              # 1 = add the cross-encoder reranker (downloads BAAI/bge-reranker-v2-m3)
# RAFEEQ_KNOWLEDGE_ROOM_TOPICS=1         # learn each room's topics from its material

# ============================================================================
# 2) M5 teacher: lecturer assistant ("جهّز المسودة" on /teacher)
# ============================================================================
# LLM_PROVIDER is shared: M5 uses it to pick its provider, and LLM_PROVIDER=ollama also moves
# the M3 tutor to a local Ollama model. Keep it "groq" for the hosted setup.
LLM_PROVIDER=groq
# the same Groq key as LLM_API_KEY is fine
GROQ_API_KEY=
# a model your key can use (list them: uv run python scripts/list_models.py)
GROQ_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0
# Other providers for M5 (only if LLM_PROVIDER points to them):
# also used for Gemini voice (TTS) and video-discovery embeddings
GOOGLE_API_KEY=
GEMINI_MODEL=
XAI_API_KEY=
XAI_MODEL=
# Local models instead (Ollama):  ollama pull qwen3:8b ; ollama pull qwen2.5vl:7b
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
# How many times a teacher may send a draft back for changes
MAX_REVISIONS=3
# Where generated .pptx / code / quiz files go (default: outputs/teacher)
# TEACHER_OUTPUT_DIR=

# Teacher data (assistant memory, class reports, inbox) survives restarts only with Postgres:
#   docker compose up -d db
# Without Docker the app logs "Falling back to in-memory storage" and keeps working (that data is lost on restart).
DATABASE_URL=postgresql://rafeeq:rafeeq@localhost:5432/rafeeq

# ============================================================================
# 3) OPTIONAL keys (every page works without them, in a reduced way)
# ============================================================================
# Web research: M3 Level 2 answers, "what is X", and the M5 outline (free key at tavily.com)
TAVILY_API_KEY=
# TAVILY_MONTHLY_LIMIT=900               # stop before the free quota ends
# Video generation (QwenCloud / Wan models)
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://maas.qwencloudapi.com
WAN_T2V_MODEL=wan2.6-t2v
WAN_I2V_MODEL=wan2.6-i2v-flash
# Narration voice: Gemini TTS when GOOGLE_API_KEY is set, edge-tts otherwise.
# TTS_PROVIDER=gemini                    # or edge, to force one
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Only for M2's own grounded answerer and its evaluation scripts (not needed by the app):
# GEMINI_API_KEY=

# LangSmith tracing (token usage and latency of every LLM call in the LangGraph parts)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rafeeq

# ============================================================================
# 4) Advanced
# ============================================================================
# Keeps web logins across server restarts. Make one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
RAFEEQ_WEB_SECRET=
# SNAP_READER=hosted                     # hosted (default with LLM_API_KEY) | ollama (local qwen2.5vl:7b) | gemini
# SNAP_VISION_MODEL=                     # another image model on the same endpoint
# STUDY_DATA_DIR=data/study              # M3 chats, memory notes, study files
# INSTRUCTOR_PIN=                        # when set, required (X-Instructor-Pin) on M3's instructor routes
# RAFEEQ_CONNECT_M3=1                    # 0 = the Copilot does not use the M3 tutor
# Development mode ONLY (the tests use it): routes skip the login and room checks, and trust X-User-Id.
# Leave it unset on any real server.
# RAFEEQ_ALLOW_ANONYMOUS=0
# Demo logins (sara@rafeeq.demo / mona@rafeeq.demo, password and tokens are public in the repo).
# Set 0 on any real server: the demo accounts stop working, also ones already saved.
# RAFEEQ_DEMO_ACCOUNTS=1
# Seconds before a stuck MCP tool (pptx, code runner, Tavily) gives up and the app falls back
# MCP_TIMEOUT_SECONDS=90

# ---- Demo -------------------------------------------------------------------
# Fill ONE room with demo students, quiz history and questions (rafeeq/demo_seed.py). Upload a PDF
# to the room first and wait until it is ready. Seeds once; never use on a real class.
# RAFEEQ_DEMO_ROOM=r_xxxxxxxx
